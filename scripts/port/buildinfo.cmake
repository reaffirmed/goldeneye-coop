# Project Midas build stamp: "Build number <count>-YYYYMMDD" on the legal screen.
#
#   cmake -DSRC=<repo> -DOUT=<header> -P buildinfo.cmake
#
# Run by the `ge_buildinfo` target on EVERY build, so the stamp is always
# current (unlike __DATE__, which only updates when its .c file recompiles).
#
#   build number = git's commit count on HEAD. It is per branch, so two
#                  branches can share a number. 0 without git or in a shallow
#                  clone (a depth-1 CI checkout would otherwise count 1).
#   commit       = HEAD's short hash; this is what really identifies the build.
#                  It goes in the log line, not the legal screen. "nogit"
#                  without git. No "-dirty" mark, because git's dirty check
#                  re-stats the whole tree and is very slow from WSL.
#   date         = the day the build ran, local time.
#   release      = the newest release tag (v*) at or before HEAD, "" when git
#                  has none (a shallow clone or a copy without tags). CI sets
#                  GE_RELEASE_TAG when it builds a release whose tag doesn't
#                  exist yet. The in-game updater (port_update.c) compares it
#                  with GitHub's newest release.
#   branch       = the checked-out branch (pc-port, mod-loader, ...): the window
#                  title, legal screen and credits name it. On a detached HEAD
#                  it is GITHUB_REF_NAME when CI sets it, else empty, and
#                  sysstubs.c falls back to "PC-Port".
#
# The header is rewritten ONLY when its text changes (new commit, new day),
# so an ordinary rebuild does not recompile anything because of it.

set(count 0)
set(commit "nogit")
set(branch "")
set(release "")
find_program(GIT_EXE git)
if(GIT_EXE)
    execute_process(COMMAND ${GIT_EXE} -C ${SRC} rev-parse --is-shallow-repository
                    OUTPUT_VARIABLE shallow RESULT_VARIABLE rc
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT (rc EQUAL 0 AND shallow STREQUAL "true"))
        execute_process(COMMAND ${GIT_EXE} -C ${SRC} rev-list --count HEAD
                        OUTPUT_VARIABLE out RESULT_VARIABLE rc
                        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(rc EQUAL 0 AND out MATCHES "^[0-9]+$")
            set(count ${out})
        endif()
    endif()
    execute_process(COMMAND ${GIT_EXE} -C ${SRC} rev-parse --short=9 HEAD
                    OUTPUT_VARIABLE out RESULT_VARIABLE rc
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(rc EQUAL 0 AND out MATCHES "^[0-9a-f]+$")
        set(commit ${out})
    endif()
    execute_process(COMMAND ${GIT_EXE} -C ${SRC} describe --tags --match "v[0-9]*" --abbrev=0 HEAD
                    OUTPUT_VARIABLE out RESULT_VARIABLE rc
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(rc EQUAL 0)
        set(release "${out}")
    endif()
    execute_process(COMMAND ${GIT_EXE} -C ${SRC} rev-parse --abbrev-ref HEAD
                    OUTPUT_VARIABLE out RESULT_VARIABLE rc
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(rc EQUAL 0 AND NOT out STREQUAL "HEAD")
        set(branch "${out}")
    endif()
endif()
if(branch STREQUAL "" AND DEFINED ENV{GITHUB_REF_NAME})
    set(branch "$ENV{GITHUB_REF_NAME}")
endif()
if(DEFINED ENV{GE_RELEASE_TAG} AND NOT "$ENV{GE_RELEASE_TAG}" STREQUAL "")
    set(release "$ENV{GE_RELEASE_TAG}")
endif()
string(REGEX REPLACE "[^A-Za-z0-9.+-]" "" release "${release}")
# it goes in a C string: keep it to plain name characters
string(REGEX REPLACE "[^A-Za-z0-9._/+-]" "" branch "${branch}")
string(TIMESTAMP day "%Y%m%d")

set(text "/* generated by scripts/port/buildinfo.cmake on every build - do not edit */
#ifndef PORT_BUILDINFO_H
#define PORT_BUILDINFO_H
#define PORT_BUILD_NUMBER ${count}
#define PORT_BUILD_DATE   \"${day}\"
#define PORT_BUILD_STRING \"${count}-${day}\"
#define PORT_BUILD_COMMIT \"${commit}\"
#define PORT_BUILD_BRANCH \"${branch}\"
#define PORT_BUILD_RELEASE \"${release}\"
#endif
")

set(old "")
if(EXISTS ${OUT})
    file(READ ${OUT} old)
endif()
if(NOT old STREQUAL text)
    file(WRITE ${OUT} "${text}")
endif()
